apiVersion: v1
kind: Service
metadata:
  name: {{ include "<% .name %>.fullname" . }}
  labels:
    {{- include "<% .name %>.labels" . | nindent 4 }}
spec:
  type: {{ .Values.service.type }}
  selector:
    {{- include "<% .name %>.selectorLabels" . | nindent 4 }}
  ports:
    - name: http
      port: {{ .Values.service.port }}
      targetPort: http
