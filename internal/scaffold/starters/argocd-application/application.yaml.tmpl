apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: <% .name %>
  namespace: argocd
spec:
  project: <% .project %>
  source:
    repoURL: <% yaml .repoURL %>
    targetRevision: <% yaml .revision %>
    path: <% yaml .path %>
  destination:
    server: https://kubernetes.default.svc
    namespace: <% .destNamespace %>
  syncPolicy:
<%- if .automated %>
    automated:
      prune: true
      selfHeal: true
<%- end %>
    syncOptions:
      - CreateNamespace=true
