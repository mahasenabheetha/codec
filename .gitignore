# Compiled binaries (anchored to repo root so internal/codec is NOT matched)
/bin/
/codec
/codec.exe

# Test artifacts
*.out
*.test

# GoReleaser output
/dist/

# Frontend build output, embedded by go:embed. The committed .keep
# keeps the directory embeddable before the frontend is ever built.
/internal/web/dist/*
!/internal/web/dist/.keep

# Local builds from scripts/dev.sh
/codec-dev
/codec-dev.exe
/codec-desktop
/codec-desktop.exe
